{
  "name": "aegires-e2ee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kettu/Revenge plugin: message encryption compatible with the Aegires Android client",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/interop.mjs && node test/attachments.mjs && node test/v2.mjs && node test/engine.mjs",
    "test:e2e": "node build.mjs && node test/e2e-mock.mjs",
    "serve": "npx http-server dist -p 4040 --cors -c-1"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "fflate": "0.8.2",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-block-scoping": "^7.25.9",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
